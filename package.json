{
  "name": "gukart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tools/**/*.mjs\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tools/**/*.mjs\" \"*.js\"",
    "smoke": "node tools/smoke.mjs",
    "test": "eslint . && vite build && node tools/smoke.mjs",
    "check": "npm run format:check && npm test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.0"
  },
  "license": "MIT"
}
